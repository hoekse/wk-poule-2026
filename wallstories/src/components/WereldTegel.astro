---
import { Image } from 'astro:assets';
import { beelden } from '@/lib/beelden';
import type { Wereld } from '@/data/werelden';
interface Props { wereld: Wereld; sizes?: string; }
const { wereld: w, sizes = '(max-width: 640px) 46vw, (max-width: 1100px) 30vw, 200px' } = Astro.props;
---
<a href={`/werelden/${w.slug}/`} class="wt" style={`--accent:${w.kleur}`}>
  <Image src={beelden[w.beeld]} alt={w.alt} widths={[240, 360, 480, 720]} sizes={sizes} loading="lazy" style={`object-position:${w.focus}`} />
  <span class="wt-naam">{w.naam}</span>
</a>

<style>
  .wt { position: relative; display: block; aspect-ratio: 3 / 4.3; border-radius: var(--r); overflow: hidden; isolation: isolate; text-decoration: none; background: var(--zand-100);
    box-shadow: var(--schaduw-s); transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease); }
  .wt:hover { transform: translateY(-4px); box-shadow: var(--schaduw); }
  .wt img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); z-index: -2; }
  .wt:hover img { transform: scale(1.06); }
  .wt::after { content: ''; position: absolute; inset: 45% 0 0; background: linear-gradient(to top, rgb(10 30 27 / 0.72), rgb(10 30 27 / 0.25) 55%, transparent); z-index: -1; }
  .wt-naam { position: absolute; left: 16px; right: 16px; bottom: 14px; font-family: var(--font-kop); font-weight: 700; font-size: 1.15rem; color: #fff; line-height: 1.1; text-shadow: 0 1px 8px rgb(0 0 0 / 0.25); }
</style>
