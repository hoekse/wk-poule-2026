    <path d="M18 38V26l5 7 5-7v12" stroke="${K}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <path d="M38 32a4 4 0 1 1 0 .1M42 28v10" stroke="${M}" stroke-width="2.6" stroke-linecap="round" fill="none"/>
    <path d="M47 38V26" stroke="${B}" stroke-width="2.6" stroke-linecap="round"/>
    ${sparkle(54, 12, 3.2, Y)}${sparkle(10, 52, 2.4, K)}`,
  schilder: `
    <path d="M31 9C16 9 5 19 5 31c0 9 7 15 14 14 5-.6 6-5 10-5 3.2 0 4.5 2.6 4.5 5.6 0 4.6 3.6 7.8 9.6 6.8C52 51 59 42 59 31 59 19 46 9 31 9z" fill="${Z}" ${s}/>
    <circle cx="19" cy="25" r="4" fill="${K}"/><circle cx="30" cy="19" r="4" fill="${Y}"/><circle cx="42" cy="21" r="4" fill="${B}"/><circle cx="49" cy="31" r="4" fill="${M}"/>
    <circle cx="20" cy="36" r="3.6" fill="${W}" ${s}/>
