    <circle cx="38" cy="13.5" r="2.2" fill="${G}"/>
    <circle cx="27" cy="36" r="1.8" fill="${G}"/><circle cx="37" cy="36" r="1.8" fill="${G}"/>
    <path d="M27 42c3 3 7 3 10 0" ${s} fill="none"/>
    <circle cx="23" cy="41" r="2.6" fill="${K}" opacity=".45"/><circle cx="41" cy="41" r="2.6" fill="${K}" opacity=".45"/>
    <path d="M49 46c3-1 6 0 7 3-2 2-5 2-7 0" fill="${M}"/>
    ${sparkle(54, 30, 2.6, Y)}`,
  kwast: `
    <path d="M44 8l8 8-17 17-8-8z" fill="${Z}" ${s}/>
    <path d="M27 25l8 8-4 4-8-8z" fill="#C9CED0" ${s}/>
    <path d="M23 29l8 8c-2 6-6 10-12 11-5 1-9 4-11 6 0-7 2-12 5-15 3-3 6-4 10-10z" fill="${B}" ${s}/>
    <path d="M12 50c2-3 5-5 8-6" stroke="${W}" stroke-width="2" stroke-linecap="round"/>
    ${sparkle(52, 34, 3.4, Y)}${sparkle(44, 46, 2.4, K)}${sparkle(57, 46, 1.8, M)}`,
  liniaal: `
    <path d="M10 40L40 10l12 12-30 30z" fill="${Y}" ${s}/>
    <path d="M17 33l3.5 3.5M22 28l2.5 2.5M27 23l3.5 3.5M32 18l2.5 2.5M37 13l3.5 3.5" ${s}/>
    <path d="M44 50c0-8 5-13 13-13 0 8-5 13-13 13z" fill="${M}" ${s}/>
    <path d="M44 50l7-7" ${s}/>
    <path d="M8 22c0-5 3-8 8-8 0 5-3 8-8 8z" fill="${M}" stroke="${G}" stroke-width="1.6" stroke-linejoin="round"/>`,
  meetlint: `
    <rect x="9" y="20" width="30" height="26" rx="8" fill="${Z}" ${s}/>
    <circle cx="24" cy="33" r="6" fill="${W}" ${s}/>
    <path d="M39 38h16v8H39" fill="${Y}" ${s}/>
