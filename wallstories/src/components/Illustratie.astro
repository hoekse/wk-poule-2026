---
/** Kleine duotone illustraties (64×64) in merkkleuren – vervangen de raster-iconen uit de mockup. */
interface Props { naam: 'boek' | 'personage' | 'kwast' | 'liniaal' | 'meetlint' | 'scherm' | 'doos' | 'naam' | 'schilder' | 'blad'; class?: string; }
const { naam, class: klasse } = Astro.props;
const G = '#18403A', Z = '#E9D6B8', M = '#A8C5B3', B = '#9DC4E0', Y = '#F0B44D', K = '#F08A76', W = '#FFFDF9';
const s = `stroke="${G}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"`;
const sparkle = (x: number, y: number, r: number, c: string) =>
  `<path d="M${x} ${y - r}C${x + r * 0.18} ${y - r * 0.18} ${x + r * 0.18} ${y - r * 0.18} ${x + r} ${y}C${x + r * 0.18} ${y + r * 0.18} ${x + r * 0.18} ${y + r * 0.18} ${x} ${y + r}C${x - r * 0.18} ${y + r * 0.18} ${x - r * 0.18} ${y + r * 0.18} ${x - r} ${y}C${x - r * 0.18} ${y - r * 0.18} ${x - r * 0.18} ${y - r * 0.18} ${x} ${y - r}Z" fill="${c}"/>`;
const svgs: Record<Props['naam'], string> = {
