---
import ThemaPagina from '@/components/ThemaPagina.astro';
---
<ThemaPagina
  pad="/dierenbehang/"
  naam="Dierenbehang"
  seoTitel="Dierenbehang kinderkamer – hertjes, jungle & safari"
  beschrijving="Dierenbehang voor de kinderkamer en babykamer: hertjes in waterverf, een jungle in zandtinten, safaridieren in lijntekening, een walvis en een dino. Op maat, pvc-vrij."
  h1="Dierenbehang voor de kinderkamer"
  lead="Hertjes in een herfstbos, een giraf tussen de palmbladeren of een walvis die een slaapliedje zingt. Kies de stijl die bij jullie kamer past; wij printen hem op de exacte maat van je muur."
  collage={['hertenbos', 'jungle', 'safari']}
  stijlen={[
    { wereld: 'hertenbos', titel: 'Zachte waterverf', voor: 'Babykamer, rustige slaapkamer', tekst: 'Een herfstbos met hertjes, vos en egel in oker, salie en stoffig blauw. Dromerig en warm.' },
    { wereld: 'jungle', titel: 'Tonaal in zandtinten', voor: 'Neutrale babykamer, meegroeikamer', tekst: 'Giraf, olifantje en zebra tussen palmbladeren, helemaal in beige en taupe. Tijdloos en rustig.' },
    { wereld: 'safari', titel: 'Fijne lijntekening', voor: 'Minimalistisch interieur, kleine kamers', tekst: 'Safaridieren in olijfgroen en warm grijs op crème, met veel lucht eromheen. Licht en luchtig.' },
    { wereld: 'onderwater', titel: 'Zeegroen en verhalend', voor: 'Slaapkamer, kinderen 0–6 jaar', tekst: 'Walvis Walter en duikertje Duikje bij de koraalboog. Rustig blauwgroen met veel te ontdekken.' },
    { wereld: 'dino', titel: 'Stoer maar vriendelijk', voor: 'Peuters en kleuters', tekst: 'Rex de T-rex met een vlinder op zijn neus in een groen dal. Avontuurlijk, nergens eng.' },
  ]}
  proza={[
    { kop: 'Dierenbehang in de babykamer', html: 'Dieren zijn vaak het eerste wat een baby herkent op de muur. Kies voor een babykamer een rustige stijl met zachte kleuren, zoals het <a href="/werelden/hertenbos/">Hertenbos</a> in waterverf of de <a href="/werelden/jungle/">Jungle</a> in zandtinten. Voor de babykamer raden we ons naadloze textiel aan: pvc-vrij en gedrukt met geurloze inkt op waterbasis. Lees meer over <a href="/inspiratie/veilig-behang-babykamer/">veilig behang in de babykamer</a>.' },
    { kop: 'Meegroeien met je kind', html: 'Een neutraal dierenbehang groeit mee: wat in de babykamer rustig is, blijft ook voor een kind van acht mooi. Wil je later meer avontuur? Combineer dan met een <a href="/behangcirkels/">behangcirkel</a> of <a href="/posters/">poster</a> uit een andere wereld, of zet de naam van je kind in de lucht. Liever dieren onder water? Bekijk ons <a href="/onderwaterbehang/">onderwaterbehang</a>.' },
    { kop: 'Zoek de dieren, en Penseel', html: 'In elke wereld van Wallstories zweeft Bella Ballon ergens in de lucht en verstopt kater Penseel zich. Zo wordt je muur ook een zoekplaatje voor het slapengaan. Benieuwd naar de verhalen achter de werelden? Lees onze <a href="/verhalen/">voorleesverhalen</a>.' },
  ]}
/>
