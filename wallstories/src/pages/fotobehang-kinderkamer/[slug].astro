---
import ProductPagina from '@/components/ProductPagina.astro';
import { productenInCategorie, type Product } from '@/data/producten';
export function getStaticPaths() {
  return productenInCategorie('fotobehang-kinderkamer').map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props as { product: Product };
---
<ProductPagina product={product} />
