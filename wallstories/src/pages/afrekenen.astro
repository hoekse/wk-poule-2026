---
import Basis from '@/layouts/Basis.astro';
import Icon from '@/components/Icon.astro';
import { aanbrengen } from '@/config';
---
<Basis titel="Afrekenen" beschrijving="Rond je bestelling bij Wallstories Kids veilig af met iDEAL." noindex>
  <section class="container sectie--krap">
    <h1>Afrekenen</h1>
    <div class="kassa">
      <form class="kaart formulier" data-kassa novalidate>
        <fieldset>
          <legend>Contactgegevens</legend>
          <div class="veld"><label for="email">E-mailadres</label><input class="invoer" id="email" name="email" type="email" autocomplete="email" required /><p class="hint">Hier sturen we je orderbevestiging en de digitale proef naartoe.</p></div>
          <div class="rij">
            <div class="veld"><label for="voornaam">Voornaam</label><input class="invoer" id="voornaam" name="voornaam" autocomplete="given-name" required /></div>
            <div class="veld"><label for="achternaam">Achternaam</label><input class="invoer" id="achternaam" name="achternaam" autocomplete="family-name" required /></div>
          </div>
          <div class="veld"><label for="telefoon">Telefoon <span class="hint">(optioneel, voor de bezorger)</span></label><input class="invoer" id="telefoon" name="telefoon" type="tel" autocomplete="tel" /></div>
        </fieldset>
        <fieldset>
          <legend>Bezorgadres <span class="hint">(alleen Nederland)</span></legend>
          <div class="rij rij-3">
            <div class="veld"><label for="postcode">Postcode</label><input class="invoer" id="postcode" name="postcode" autocomplete="postal-code" placeholder="1234 AB" required pattern="[1-9][0-9]{3} ?[A-Za-z]{2}" /></div>
            <div class="veld"><label for="huisnummer">Huisnummer</label><input class="invoer" id="huisnummer" name="huisnummer" inputmode="numeric" required /></div>
            <div class="veld"><label for="toevoeging">Toevoeging</label><input class="invoer" id="toevoeging" name="toevoeging" /></div>
          </div>
          <div class="rij">
            <div class="veld"><label for="straat">Straat</label><input class="invoer" id="straat" name="straat" autocomplete="address-line1" required /></div>
            <div class="veld"><label for="plaats">Plaats</label><input class="invoer" id="plaats" name="plaats" autocomplete="address-level2" required /></div>
          </div>
          <p class="hint" data-adres-hint>Vul je postcode en huisnummer in, dan vullen we straat en plaats automatisch aan.</p>
          <div class="veld"><label for="opmerking">Opmerking <span class="hint">(optioneel)</span></label><textarea class="invoer" id="opmerking" name="opmerking" rows="3" placeholder="Bijv. een cadeauboodschap of bezorginstructie"></textarea></div>
        </fieldset>
        {aanbrengen.actief && (
          <fieldset class="aanbreng-optie" data-aanbreng-optie hidden>
            <label class="vink"><input type="checkbox" name="aanbrengen" /> <span><b>Laat mijn fotobehang aanbrengen</b> door onze partner {aanbrengen.partner} ({aanbrengen.tariefTekst.toLowerCase()}). Je ontvangt eerst een offerte; nu betaal je alleen het behang.</span></label>
          </fieldset>
        )}
        <fieldset class="akkoord">
          <label class="vink"><input type="checkbox" name="voorwaarden" required /> <span>Ik ga akkoord met de <a href="/algemene-voorwaarden/" target="_blank">algemene voorwaarden</a> en het <a href="/privacy/" target="_blank">privacybeleid</a>.</span></label>
          <label class="vink" data-maatwerk-akkoord hidden><input type="checkbox" name="maatwerk" /> <span>Ik begrijp dat <b>maatwerk en gepersonaliseerde producten</b> speciaal voor mij worden gemaakt en daarom <b>niet onder het herroepingsrecht</b> vallen (art. 6:230p BW).</span></label>
        </fieldset>
        <button type="submit" class="knop knop--groot knop--blok" data-betaal><Icon naam="slot" /> <span data-betaal-tekst>Bestellen en betalen</span></button>
        <p class="fout" data-fout role="alert"></p>
        <p class="hint centreer">Je betaalt veilig via Mollie met iDEAL of een andere methode naar keuze.</p>
      </form>
      <aside class="kaart overzicht">
        <h2 class="h-klein">Je bestelling</h2>
        <div data-kassa-regels class="compact"></div>
        <div data-kassa-totalen></div>
        <ul class="checklist klein garanties">
          <li><Icon naam="vink-rond" /> Digitale proef bij personalisatie</li>
          <li><Icon naam="vink-rond" /> Op bestelling geprint, zorgvuldig verpakt</li>
          <li><Icon naam="vink-rond" /> Vragen? <a href="/contact/">Wij helpen je</a></li>
        </ul>
      </aside>
    </div>
  </section>
</Basis>
<script>
  import { winkelwagen, renderRegels, renderTotalen, koppelActies } from '@/scripts/winkelwagen';
  import { prijsVoor, euro } from '@/lib/prijs';
  const form = document.querySelector<HTMLFormElement>('[data-kassa]')!;
  const regels = document.querySelector<HTMLElement>('[data-kassa-regels]')!;
  const totalen = document.querySelector<HTMLElement>('[data-kassa-totalen]')!;
  const maatwerk = form.querySelector<HTMLElement>('[data-maatwerk-akkoord]')!;
  const aanbreng = form.querySelector<HTMLElement>('[data-aanbreng-optie]');
  const fout = form.querySelector<HTMLElement>('[data-fout]')!;
  const knop = form.querySelector<HTMLButtonElement>('[data-betaal]')!;
  const knopTekst = form.querySelector<HTMLElement>('[data-betaal-tekst]')!;

  const update = () => {
    renderRegels(regels); renderTotalen(totalen);
    const items = winkelwagen.items();
    const heeftMaatwerk = items.some((i) => prijsVoor(i.config).maatwerk);
    maatwerk.hidden = !heeftMaatwerk;
    maatwerk.querySelector('input')!.required = heeftMaatwerk;
    if (aanbreng) aanbreng.hidden = !items.some((i) => i.config.type === 'fotobehang');
    const t = winkelwagen.totalen();
    knop.disabled = t.aantal === 0;
    knopTekst.textContent = t.aantal ? `Bestellen en betalen · ${euro(t.totaal)}` : 'Je winkelwagen is leeg';
  };
  koppelActies(regels); winkelwagen.bijWijziging(update); update();

  // Adres aanvullen via PDOK Locatieserver (open data van de overheid)
  const pc = form.querySelector<HTMLInputElement>('#postcode')!;
  const hn = form.querySelector<HTMLInputElement>('#huisnummer')!;
  const hint = form.querySelector<HTMLElement>('[data-adres-hint]')!;
  let timer: number | undefined;
  const zoekAdres = async () => {
    const postcode = pc.value.replace(/\s/g, '').toUpperCase();
    const nummer = hn.value.trim().match(/^\d+/)?.[0];
    if (!/^[1-9]\d{3}[A-Z]{2}$/.test(postcode) || !nummer) return;
    try {
      const url = `https://api.pdok.nl/bzk/locatieserver/search/v3_1/free?q=postcode:${postcode}%20and%20huisnummer:${nummer}&fq=type:adres&rows=1&fl=straatnaam,woonplaatsnaam`;
      const r = await fetch(url); const j = await r.json();
      const d = j?.response?.docs?.[0];
      if (d) {
        (form.querySelector('#straat') as HTMLInputElement).value = d.straatnaam;
        (form.querySelector('#plaats') as HTMLInputElement).value = d.woonplaatsnaam;
        hint.textContent = `Gevonden: ${d.straatnaam} ${hn.value}, ${d.woonplaatsnaam}`;
      } else hint.textContent = 'Adres niet gevonden – vul straat en plaats zelf in.';
    } catch { /* handmatig invullen blijft mogelijk */ }
  };
  [pc, hn].forEach((el) => el.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(zoekAdres, 350); }));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    fout.textContent = '';
    if (!form.reportValidity()) return;
    const f = Object.fromEntries(new FormData(form)) as Record<string, string>;
    knop.disabled = true; knopTekst.textContent = 'Een moment…';
    try {
      const res = await fetch('/api/bestelling/', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          klant: { email: f.email, voornaam: f.voornaam, achternaam: f.achternaam, telefoon: f.telefoon, postcode: f.postcode, huisnummer: f.huisnummer, toevoeging: f.toevoeging, straat: f.straat, plaats: f.plaats, opmerking: f.opmerking },
          regels: winkelwagen.items().map((i) => ({ key: i.key, config: i.config, aantal: i.aantal })),
          akkoordVoorwaarden: !!f.voorwaarden, akkoordMaatwerk: !!f.maatwerk, aanbrengen: !!f.aanbrengen,
        }),
      });
      const j = await res.json().catch(() => ({}));
      if (!res.ok || !j.checkoutUrl) throw new Error(j.fout || 'Afrekenen is niet gelukt. Probeer het opnieuw.');
      location.href = j.checkoutUrl;
    } catch (err) {
      fout.textContent = (err as Error).message.includes('fetch') ? 'Geen verbinding met de betaalserver. Probeer het later opnieuw.' : (err as Error).message;
      update();
    }
  });
</script>
<style>
  h1 { font-size: clamp(2.2rem, 1.5rem + 2.4vw, 3.4rem); }
  .kassa { display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: start; }
  .formulier { padding: clamp(20px, 3vw, 36px); display: grid; gap: 26px; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 14px; }
  legend { font-family: var(--font-kop); font-weight: 700; font-size: 1.3rem; color: var(--groen); margin-bottom: 8px; padding: 0; }
  .rij { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .rij-3 { grid-template-columns: 1.3fr 1fr 1fr; }
  .vink { display: flex; gap: 12px; align-items: flex-start; font-size: 0.92rem; cursor: pointer; }
  .vink[hidden] { display: none; }
  .vink input { width: 20px; height: 20px; margin-top: 2px; flex: none; accent-color: var(--groen); }
  .vink a { color: var(--groen); font-weight: 700; }
  .akkoord { padding: 18px; border-radius: var(--r); background: var(--zand-100); }
  .aanbreng-optie { padding: 16px 18px; border-radius: var(--r); border: 1.5px dashed var(--rand-sterk); }
  .aanbreng-optie[hidden] { display: none; }
  .centreer { text-align: center; margin: 0; }
  .overzicht { padding: 28px; position: sticky; top: calc(var(--header-h) + 20px); display: grid; gap: 12px; }
  .h-klein { font-size: 1.4rem; margin: 0; }
  .compact :global(.ww-regel) { grid-template-columns: 64px 1fr auto; }
  .compact :global(.ww-thumb) { width: 64px; height: 64px; }
  .garanties { margin-top: 8px; }
  .garanties a { color: var(--groen); font-weight: 700; }
  @media (max-width: 900px) { .kassa { grid-template-columns: 1fr; } .overzicht { position: static; order: -1; } }
  @media (max-width: 520px) { .rij, .rij-3 { grid-template-columns: 1fr; } }
</style>
