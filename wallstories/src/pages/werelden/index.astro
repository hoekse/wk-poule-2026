---
import { Image } from 'astro:assets';
import Basis from '@/layouts/Basis.astro';
import Kruimelpad from '@/components/Kruimelpad.astro';
import Icon from '@/components/Icon.astro';
import { werelden } from '@/data/werelden';
import { beelden } from '@/lib/beelden';
import { kruimelpad } from '@/lib/schema';
const kruimels = [{ naam: 'Home', url: '/' }, { naam: 'Werelden', url: '/werelden/' }];
---
<Basis titel="Alle werelden – thema's voor de kinderkamer" beschrijving="Ontdek de zes werelden van Wallstories Kids: Rembrandts Atelier, Onderwater, Ruimte, Dino, Bouwplaats en Sprookjes. Als fotobehang, behangcirkel, poster en sticker." jsonLd={[kruimelpad(Astro.site, kruimels)]}>
  <Kruimelpad items={kruimels} />
  <header class="container kop">
    <span class="eyebrow">Ontdek de werelden</span>
    <h1>Welke wereld kies jij?</h1>
    <p class="lead">Elke wereld is een compleet verhaal, met details om elke dag iets nieuws in te ontdekken. Kies een wereld en maak hem compleet met behang, cirkels, posters en stickers.</p>
  </header>
  <section class="container sectie--krap">
    <ul class="werelden">
      {werelden.map((w, i) => (
        <li data-onthul>
          <a href={`/werelden/${w.slug}/`} class="wereld" style={`--accent:${w.kleur}`}>
            <div class="media media--zoom"><Image src={beelden[w.beeld]} alt={w.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 92vw, 600px" loading={i < 2 ? 'eager' : 'lazy'} /></div>
            <div class="wereld-tekst">
              <h2>{w.naam}</h2>
              <p class="verhaal">{w.verhaal}</p>
              <p class="zacht">{w.intro}</p>
              <span class="link-pijl">Ontdek {w.naam} <Icon naam="pijl" /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Basis>
<style>
  .kop h1 { font-size: clamp(2.4rem, 1.6rem + 3vw, 4.2rem); }
  .werelden { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 48px 32px; }
  .wereld { display: grid; gap: 18px; text-decoration: none; color: inherit; }
  .wereld .media { aspect-ratio: 16 / 9; }
  .wereld h2 { margin: 0; }
  .verhaal { font-weight: 700; color: var(--groen); margin: 2px 0 8px; }
  @media (max-width: 760px) { .werelden { grid-template-columns: 1fr; } }
</style>
