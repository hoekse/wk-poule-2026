---
import ThemaPagina from '@/components/ThemaPagina.astro';
---
<ThemaPagina
  pad="/onderwaterbehang/"
  naam="Onderwaterbehang"
  seoTitel="Onderwater behang kinderkamer – walvis, koraal & zee"
  beschrijving="Onderwater behang voor de kinderkamer: een walvis in zachte waterverf, een koraalrif in zee- en zandtinten of zeedieren in lijntekening. Fotobehang op maat, pvc-vrij."
  h1="Onderwater behang voor de kinderkamer"
  lead="Een walvis met haar kalfje, een octopus tussen het koraal of een zeepaardje in fijne lijnen. Onderwaterbehang brengt rust in de kamer: blauw en groen zijn de kleuren van slapen."
  collage={['walvisbaai', 'koraalrif', 'zeeleven']}
  stijlen={[
    { wereld: 'walvisbaai', titel: 'Zachte waterverf', voor: 'Babykamer, rustige slaapkamer', tekst: 'Walter de walvis met een kalfje, schildpadden en kwallen als lampionnetjes in pastelblauw en mint.' },
    { wereld: 'koraalrif', titel: 'Tonaal in zee- en zandtinten', voor: 'Neutrale babykamer, meegroeikamer', tekst: 'Een octopus, zeeschildpad en zeepaardjes tussen het koraal, in gedempt blauw, teal en zand.' },
    { wereld: 'zeeleven', titel: 'Fijne lijntekening', voor: 'Minimalistisch interieur, kleine kamers', tekst: 'Walvis, octopus, zeepaardje en kwallen in stoffig blauw op crème, met veel rust eromheen.' },
    { wereld: 'onderwater', titel: 'Verhalend en zeegroen', voor: 'Kinderen 0–6 jaar', tekst: 'Het voorleesverhaal op de muur: Walter, Duikje en de schelp met de zeegroene parel.' },
  ]}
  proza={[
    { kop: 'Waarom onderwaterbehang zo rustig is', html: 'Blauw en groen zijn kleuren die rust geven. Daarom kiezen veel ouders voor een onderwaterwereld in de slaapkamer: genoeg om naar te kijken, zonder dat het druk wordt. Kies voor een babykamer een zachte stijl zoals <a href="/werelden/walvisbaai/">Walvisbaai</a> in waterverf of het <a href="/werelden/koraalrif/">Koraalrif</a> in zee- en zandtinten.' },
    { kop: 'Combineren met cirkels en posters', html: 'Hang een <a href="/behangcirkels/">behangcirkel</a> met de walvis boven het bedje, of maak de kamer af met een <a href="/posters/">poster</a> met de naam van je kind. Alle onderwaterwerelden passen bij elkaar, dus je kunt stijlen combineren. Meer dieren vind je bij ons <a href="/dierenbehang/">dierenbehang</a>.' },
    { kop: 'Lees het verhaal van de zee', html: 'In het voorleesverhaal <a href="/verhalen/onderwater/">Op reis met de grote walvis</a> zingt Walter zo zacht als hij kan, zodat de oude schelp opengaat. Een fijn verhaal om voor te lezen onder je eigen onderwatermuur. En kijk goed: kater Penseel drijft in elke onderwaterwereld ergens in een luchtbel.' },
  ]}
/>
