# Kopieer naar .env (lokaal) en zet dezelfde variabelen in Vercel → Project → Settings → Environment Variables.
SITE_URL=https://www.wallstories.nl

# Mollie (dashboard.mollie.com → Ontwikkelaars → API-sleutels). Begin met de test_-sleutel.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (Project Settings → API). Service-role-sleutel ALLEEN server-side gebruiken.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optioneel: orderbevestigingen per e-mail via Resend (resend.com). Zonder sleutel wordt er niets gemaild.
RESEND_API_KEY=
MAIL_FROM="Wallstories Kids <bestellingen@wallstories.nl>"
MAIL_BCC=
