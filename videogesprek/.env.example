# Kopieer naar .env.local (lokaal) of zet deze in Vercel > Settings > Environment Variables.

# Toegangscode: wie de app opent, moet eerst deze code invullen.
# Zonder code is de app in productie dicht.
TOEGANGSCODE=

# OpenAI: spraak-naar-tekst (gpt-transcribe). Zonder sleutel valt de app
# terug op de spraakherkenning van de browser (op iPhone minder betrouwbaar).
OPENAI_API_KEY=

# Anthropic: Claude Haiku kiest het best passende antwoord. Zonder sleutel
# vergelijkt de app de tekst zelf met de vragenlijst (minder slim).
ANTHROPIC_API_KEY=

# Optioneel: onder deze zekerheid (0 tot 1) speelt onbekend.mp4. Standaard 0.6.
# ZEKERHEID_DREMPEL=0.6

# Optioneel: ander OpenAI-transcriptiemodel. Standaard gpt-transcribe.
# OPENAI_TRANSCRIPTIE_MODEL=gpt-transcribe
